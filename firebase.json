{
  "hosting": {
    "public": "playground/dist",
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/ornek-foto/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
    ]
  }
}
